{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onehtml",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/preview",
      "/robots.txt",
      "/api/*",
      "/play/*",
      "/work/*",
      "/sitemap.xml",
      "/games",
      "/experiments",
      "/tools",
      "/llms.txt"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onehtml-db",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ONEHTML_STORAGE",
      "id": "b7904ff0ee4240d59599d88ab18ca22c"
    }
  ],
  "vars": {
    "DEMO_ONLY": "false",
    "SITE_ORIGIN": "https://onehtml.dev",
    "SANDBOX_ORIGIN": "https://onehtmlusercontent.com"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
